# 换行符策略：仓库内统一存 LF，检出时由 Git 按规则转换
* text=auto eol=lf

# Windows 专用脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.pcap binary
*.pcapng binary
*.sqlite binary
*.db binary
